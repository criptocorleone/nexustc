---
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaOrg from '../components/seo/SchemaOrg.astro';

const pageTitle = 'Sua empresa aparece no ChatGPT? Teste gratuito | Nexus TC';
const pageDescription = 'Descubra se o ChatGPT e o Perplexity citam sua empresa ou seus concorrentes quando um cliente pergunta pelo seu serviço. Teste gratuito, resultado no WhatsApp.';
const canonicalUrl = 'https://nexustc.com.br/visibilidade-em-ia';

const faqs = [
  {
    question: 'É gratuito?',
    answer: 'Sim. É um teste curto para você ver como sua empresa aparece hoje.',
  },
  {
    question: 'Vocês garantem que minha empresa vai passar a ser citada?',
    answer: 'Não. Nenhuma empresa controla o que uma IA responde. O que dá para fazer é melhorar os sinais que essas ferramentas usam para escolher quem citar, e medir a evolução.',
  },
  {
    question: 'O resultado muda de um dia para o outro?',
    answer: 'Pode mudar. Por isso o teste é uma fotografia do momento, e o acompanhamento contínuo é feito com as mesmas perguntas ao longo do tempo.',
  },
  {
    question: 'Preciso dar acesso a alguma coisa?',
    answer: 'Não. Fazemos as perguntas como qualquer pessoa faria.',
  },
];

const pageSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: pageTitle,
    description: pageDescription,
    url: canonicalUrl,
    inLanguage: 'pt-BR',
    isPartOf: {
      '@type': 'WebSite',
      name: 'Nexus TC',
      url: 'https://nexustc.com.br',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  hideHeader={true}
  hideFooter={true}
>
  <SchemaOrg schema={pageSchemas} />

  <!-- Header Simplificado: Logo + Botão discreto de WhatsApp -->
  <header class="rx-header">
    <div class="rx-header__inner">
      <a href="/" class="ds-logo" aria-label="Nexus TC: Página inicial">
        <span class="ds-logo__mark" aria-hidden="true"></span>
        <span>Nexus TC</span>
      </a>

      <a
        href="https://wa.me/551123912873"
        target="_blank"
        rel="noopener noreferrer"
        class="ds-btn ds-btn--secondary ds-btn--sm js-wa-link"
        aria-label="Falar no WhatsApp (abre em nova aba)"
      >
        <span>Falar no WhatsApp</span>
      </a>
    </div>
  </header>

  <!-- Seção 1: Hero com Formulário Mobile-First -->
  <section class="rx-hero" aria-labelledby="hero-title">
    <div class="rx-container">
      <div class="rx-hero__head">
        <span class="ds-chip">TESTE GRATUITO</span>
        <h1 id="hero-title" class="rx-h1">Quando perguntam ao ChatGPT pelo seu serviço, quem ele indica?</h1>
        <p class="rx-lead">
          Fazemos 5 perguntas reais do seu mercado ao ChatGPT e ao Perplexity e mostramos quem aparece nas respostas: você ou seus concorrentes. Resultado em até 3 dias úteis no WhatsApp.
        </p>
      </div>

      <!-- Formulário de Captação -->
      <div class="rx-form-box" id="form-container">
        <form id="form-ia" class="rx-form" novalidate>
          <div class="rx-form__grid">
            <div class="rx-form__field">
              <label for="ia-site" class="rx-label">Endereço do site *</label>
              <input
                type="url"
                id="ia-site"
                name="site"
                class="rx-input"
                placeholder="seusite.com.br"
                autocomplete="url"
                required
              />
              <span class="rx-error" id="error-site" aria-live="polite"></span>
            </div>

            <div class="rx-form__field">
              <label for="ia-nome" class="rx-label">Seu nome *</label>
              <input
                type="text"
                id="ia-nome"
                name="nome"
                class="rx-input"
                placeholder="Nome completo"
                autocomplete="name"
                required
              />
              <span class="rx-error" id="error-nome" aria-live="polite"></span>
            </div>
          </div>

          <div class="rx-form__grid">
            <div class="rx-form__field">
              <label for="ia-whatsapp" class="rx-label">WhatsApp *</label>
              <input
                type="tel"
                id="ia-whatsapp"
                name="whatsapp"
                class="rx-input"
                placeholder="(11) 91234-5678"
                autocomplete="tel"
                required
              />
              <span class="rx-error" id="error-whatsapp" aria-live="polite"></span>
            </div>

            <div class="rx-form__field">
              <label for="ia-segmento" class="rx-label">Segmento *</label>
              <select id="ia-segmento" name="segmento" class="rx-select" required>
                <option value="" disabled selected>Selecione seu segmento</option>
                <option value="Indústria">Indústria</option>
                <option value="Logística/Distribuição">Logística/Distribuição</option>
                <option value="Startup/SaaS">Startup/SaaS</option>
                <option value="Escola">Escola</option>
                <option value="Negócio nos EUA">Negócio nos EUA</option>
                <option value="Outro">Outro</option>
              </select>
              <span class="rx-error" id="error-segmento" aria-live="polite"></span>
            </div>
          </div>

          <div class="rx-form__grid">
            <div class="rx-form__field">
              <label for="ia-o-que-vende" class="rx-label">O que sua empresa vende? *</label>
              <input
                type="text"
                id="ia-o-que-vende"
                name="o_que_vende"
                class="rx-input"
                placeholder="ex.: usinagem de peças sob medida"
                required
              />
              <span class="rx-error" id="error-o-que-vende" aria-live="polite"></span>
            </div>

            <div class="rx-form__field">
              <label for="ia-regiao" class="rx-label">Cidade ou região que vocês atendem *</label>
              <input
                type="text"
                id="ia-regiao"
                name="regiao"
                class="rx-input"
                placeholder="ex.: Grande São Paulo"
                required
              />
              <span class="rx-error" id="error-regiao" aria-live="polite"></span>
            </div>
          </div>

          <div class="rx-form__field rx-form__field--full">
            <label for="ia-concorrentes" class="rx-label">Principais concorrentes</label>
            <textarea
              id="ia-concorrentes"
              name="concorrentes"
              class="rx-textarea"
              placeholder="até 3 nomes ou sites"
              rows="2"
            ></textarea>
            <span class="rx-error" id="error-concorrentes" aria-live="polite"></span>
          </div>

          <div class="rx-form__action">
            <button type="submit" id="ia-submit-btn" class="ds-btn ds-btn--primary rx-submit-btn">
              <span>Quero meu teste</span>
            </button>
            <p class="rx-microtext">
              Gratuito. Sem reunião e sem proposta automática. As perguntas são feitas por uma pessoa, não por robô.
            </p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- Seção 2: O que você recebe -->
  <section class="rx-section rx-section--alt" aria-labelledby="recebe-title">
    <div class="rx-container">
      <div class="rx-section__head">
        <span class="ds-label">Entregáveis</span>
        <h2 id="recebe-title" class="ds-h2">O que você recebe</h2>
      </div>

      <div class="rx-cards-grid">
        <div class="rx-card">
          <span class="rx-card__num" aria-hidden="true">01</span>
          <p class="rx-card__text">
            As 5 perguntas que fizemos, escritas como um cliente seu escreveria.
          </p>
        </div>

        <div class="rx-card">
          <span class="rx-card__num" aria-hidden="true">02</span>
          <p class="rx-card__text">
            Quem foi citado em cada resposta do ChatGPT e do Perplexity, você e os concorrentes.
          </p>
        </div>

        <div class="rx-card">
          <span class="rx-card__num" aria-hidden="true">03</span>
          <p class="rx-card__text">
            Os primeiros ajustes para sua empresa começar a ser considerada nas respostas.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Seção 3: Por que isso importa agora -->
  <section class="rx-section" aria-labelledby="importa-title">
    <div class="rx-container">
      <div class="rx-section__head">
        <span class="ds-label">Mudança de comportamento</span>
        <h2 id="importa-title" class="ds-h2">Por que isso importa agora</h2>
      </div>

      <div class="rx-target-box">
        <p class="rx-target-box__text">
          Cada vez mais gente pergunta direto para uma IA antes de pesquisar no Google: "qual a melhor transportadora em Guarulhos?", "qual escola bilíngue na Vila Mariana?". A resposta vem pronta, com 3 ou 4 nomes. Se o seu não está entre eles, você não chega nem a ser comparado.
        </p>
      </div>
    </div>
  </section>

  <!-- Seção 4: Exemplo de resultado -->
  <section class="rx-section rx-section--alt" aria-labelledby="exemplo-title">
    <div class="rx-container">
      <div class="rx-section__head">
        <span class="ds-label">Exemplo ilustrativo</span>
        <h2 id="exemplo-title" class="ds-h2">Exemplo de resultado</h2>
      </div>

      <!-- Tabela para Desktop e Telas Médias -->
      <div class="rx-table-wrap">
        <table class="rx-table">
          <thead>
            <tr>
              <th scope="col" class="rx-table__th rx-table__th--pergunta">Pergunta</th>
              <th scope="col" class="rx-table__th">ChatGPT</th>
              <th scope="col" class="rx-table__th">Perplexity</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="rx-table__td rx-table__td--pergunta">Qual a melhor empresa de [serviço] em [cidade]?</td>
              <td class="rx-table__td">Concorrente A, Concorrente B</td>
              <td class="rx-table__td">Concorrente A</td>
            </tr>
            <tr>
              <td class="rx-table__td rx-table__td--pergunta">Quem faz [serviço] com entrega rápida em [região]?</td>
              <td class="rx-table__td">Concorrente C</td>
              <td class="rx-table__td"><strong class="rx-highlight">Sua empresa</strong>, Concorrente A</td>
            </tr>
            <tr>
              <td class="rx-table__td rx-table__td--pergunta">[serviço] confiável para indústria em [cidade]</td>
              <td class="rx-table__td rx-table__td--muted">Nenhuma empresa citada</td>
              <td class="rx-table__td">Concorrente B</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Lista responsiva para Mobile -->
      <div class="rx-table-list-mobile">
        <div class="rx-table-card">
          <div class="rx-table-card__head">
            <span class="rx-table-card__tag">Pergunta</span>
            <p class="rx-table-card__question">Qual a melhor empresa de [serviço] em [cidade]?</p>
          </div>
          <div class="rx-table-card__body">
            <div class="rx-table-card__row">
              <span class="rx-table-card__ai">ChatGPT:</span>
              <span class="rx-table-card__val">Concorrente A, Concorrente B</span>
            </div>
            <div class="rx-table-card__row">
              <span class="rx-table-card__ai">Perplexity:</span>
              <span class="rx-table-card__val">Concorrente A</span>
            </div>
          </div>
        </div>

        <div class="rx-table-card">
          <div class="rx-table-card__head">
            <span class="rx-table-card__tag">Pergunta</span>
            <p class="rx-table-card__question">Quem faz [serviço] com entrega rápida em [região]?</p>
          </div>
          <div class="rx-table-card__body">
            <div class="rx-table-card__row">
              <span class="rx-table-card__ai">ChatGPT:</span>
              <span class="rx-table-card__val">Concorrente C</span>
            </div>
            <div class="rx-table-card__row">
              <span class="rx-table-card__ai">Perplexity:</span>
              <span class="rx-table-card__val"><strong class="rx-highlight">Sua empresa</strong>, Concorrente A</span>
            </div>
          </div>
        </div>

        <div class="rx-table-card">
          <div class="rx-table-card__head">
            <span class="rx-table-card__tag">Pergunta</span>
            <p class="rx-table-card__question">[serviço] confiável para indústria em [cidade]</p>
          </div>
          <div class="rx-table-card__body">
            <div class="rx-table-card__row">
              <span class="rx-table-card__ai">ChatGPT:</span>
              <span class="rx-table-card__val rx-table-card__val--muted">Nenhuma empresa citada</span>
            </div>
            <div class="rx-table-card__row">
              <span class="rx-table-card__ai">Perplexity:</span>
              <span class="rx-table-card__val">Concorrente B</span>
            </div>
          </div>
        </div>
      </div>

      <div class="rx-closing-note">
        <p class="rx-closing-note__text">
          "Neste exemplo, a empresa aparece em 1 de 6 respostas. O concorrente A, em 3."
        </p>
      </div>
    </div>
  </section>

  <!-- Seção 5: Como funciona -->
  <section class="rx-section" aria-labelledby="funciona-title">
    <div class="rx-container">
      <div class="rx-section__head">
        <span class="ds-label">Passo a passo</span>
        <h2 id="funciona-title" class="ds-h2">Como funciona</h2>
      </div>

      <div class="rx-steps-grid">
        <div class="rx-step">
          <div class="rx-step__badge">1</div>
          <div class="rx-step__body">
            <h3 class="rx-step__title">Você conta o que vende, onde atua e quem são seus concorrentes.</h3>
          </div>
        </div>

        <div class="rx-step">
          <div class="rx-step__badge">2</div>
          <div class="rx-step__body">
            <h3 class="rx-step__title">
              Montamos 5 perguntas como um cliente faria e rodamos no ChatGPT e no Perplexity.
            </h3>
          </div>
        </div>

        <div class="rx-step">
          <div class="rx-step__badge">3</div>
          <div class="rx-step__body">
            <h3 class="rx-step__title">
              Em até 3 dias úteis, você recebe o resultado no WhatsApp. Se quiser ajuda para melhorar, a gente conversa. Se não quiser, o material é seu.
            </h3>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Seção 6: Perguntas frequentes -->
  <section class="rx-section rx-section--alt" aria-labelledby="faq-title">
    <div class="rx-container">
      <div class="rx-section__head">
        <span class="ds-label">Dúvidas comuns</span>
        <h2 id="faq-title" class="ds-h2">Perguntas frequentes</h2>
      </div>

      <div class="rx-faq-list">
        {faqs.map((faq) => (
          <details class="rx-faq-item">
            <summary class="rx-faq-question">
              <span class="rx-faq-q-text">{faq.question}</span>
              <span class="rx-faq-icon" aria-hidden="true">+</span>
            </summary>
            <div class="rx-faq-answer">
              <p class="rx-faq-a-text">{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Seção 7: CTA Final -->
  <section class="rx-cta-final" aria-labelledby="cta-final-title">
    <div class="rx-container">
      <div class="rx-cta-final__box ds-grain">
        <h2 id="cta-final-title" class="rx-cta-final__title">Descubra quem a IA indica no seu lugar</h2>
        <button type="button" id="cta-scroll-btn" class="ds-btn ds-btn--secondary rx-cta-final__btn">
          <span>Quero meu teste</span>
        </button>
        <a href="/raio-x-do-site" class="rx-cross-link">
          Prefere começar pelo seu site? Peça o raio-x gratuito
        </a>
      </div>
    </div>
  </section>

  <!-- Rodapé Simplificado -->
  <footer class="rx-footer">
    <div class="rx-container">
      <p class="rx-footer__text">
        Nexus TC | Tráfego e conversão | SEO, Google Ads, CRO e sites.
      </p>
    </div>
  </footer>
</BaseLayout>

<script is:inline>
  // Constante de endpoint solicitada
  const FORM_ENDPOINT = ''; // TODO: colar endpoint

  // Utilitários de normalização e validação
  function normalizeUrl(value) {
    if (!value) return '';
    let val = value.trim();
    if (!/^https?:\/\//i.test(val)) {
      val = 'https://' + val;
    }
    return val;
  }

  function isValidDomainOrUrl(value) {
    if (!value) return false;
    const normalized = normalizeUrl(value);
    try {
      const parsed = new URL(normalized);
      return parsed.hostname.includes('.') && parsed.hostname.length >= 4;
    } catch {
      return false;
    }
  }

  function formatPhoneInput(val) {
    if (!val) return '';
    const trimmed = val.trim();
    const isUS = trimmed.startsWith('+');

    if (isUS) {
      const digits = trimmed.slice(1).replace(/\D/g, '');
      if (digits.startsWith('1')) {
        const sub = digits.slice(1, 11);
        if (sub.length === 0) return '+1 ';
        if (sub.length <= 3) return '+1 (' + sub;
        if (sub.length <= 6) return '+1 (' + sub.slice(0, 3) + ') ' + sub.slice(3);
        return '+1 (' + sub.slice(0, 3) + ') ' + sub.slice(3, 6) + '-' + sub.slice(6);
      }
      return '+' + digits.slice(0, 15);
    }

    const digits = val.replace(/\D/g, '').slice(0, 11);
    if (digits.length === 0) return '';
    if (digits.length <= 2) return '(' + digits;
    if (digits.length <= 6) return '(' + digits.slice(0, 2) + ') ' + digits.slice(2);
    if (digits.length <= 10) return '(' + digits.slice(0, 2) + ') ' + digits.slice(2, 6) + '-' + digits.slice(6);
    return '(' + digits.slice(0, 2) + ') ' + digits.slice(2, 7) + '-' + digits.slice(7);
  }

  function isValidPhone(val) {
    if (!val) return false;
    const trimmed = val.trim();
    if (trimmed.startsWith('+1')) {
      const digits = trimmed.replace(/\D/g, '');
      return digits.length === 11; // 1 + 10 digits
    }
    if (trimmed.startsWith('+')) {
      const digits = trimmed.replace(/\D/g, '');
      return digits.length >= 8 && digits.length <= 15;
    }
    const digits = val.replace(/\D/g, '');
    return digits.length === 10 || digits.length === 11;
  }

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('form-ia');
    const container = document.getElementById('form-container');
    const siteInput = document.getElementById('ia-site');
    const nomeInput = document.getElementById('ia-nome');
    const waInput = document.getElementById('ia-whatsapp');
    const segmentoInput = document.getElementById('ia-segmento');
    const oQueVendeInput = document.getElementById('ia-o-que-vende');
    const regiaoInput = document.getElementById('ia-regiao');
    const concorrentesInput = document.getElementById('ia-concorrentes');
    const submitBtn = document.getElementById('ia-submit-btn');
    const ctaScrollBtn = document.getElementById('cta-scroll-btn');

    // Máscara de telefone
    if (waInput) {
      waInput.addEventListener('input', () => {
        const oldVal = waInput.value;
        const formatted = formatPhoneInput(oldVal);
        waInput.value = formatted;
        clearError('whatsapp');
      });
    }

    // Normalização do site no blur
    if (siteInput) {
      siteInput.addEventListener('blur', () => {
        if (siteInput.value.trim()) {
          siteInput.value = normalizeUrl(siteInput.value);
        }
      });
      siteInput.addEventListener('input', () => clearError('site'));
    }

    if (nomeInput) {
      nomeInput.addEventListener('input', () => clearError('nome'));
    }

    if (segmentoInput) {
      segmentoInput.addEventListener('change', () => clearError('segmento'));
    }

    if (oQueVendeInput) {
      oQueVendeInput.addEventListener('input', () => clearError('o-que-vende'));
    }

    if (regiaoInput) {
      regiaoInput.addEventListener('input', () => clearError('regiao'));
    }

    function setError(fieldName, message) {
      const errEl = document.getElementById('error-' + fieldName);
      const inputEl = document.getElementById('ia-' + fieldName);
      if (errEl) errEl.textContent = message;
      if (inputEl) {
        inputEl.setAttribute('aria-invalid', 'true');
        inputEl.focus();
      }
    }

    function clearError(fieldName) {
      const errEl = document.getElementById('error-' + fieldName);
      const inputEl = document.getElementById('ia-' + fieldName);
      if (errEl) errEl.textContent = '';
      if (inputEl) inputEl.removeAttribute('aria-invalid');
    }

    function clearAllErrors() {
      ['site', 'nome', 'whatsapp', 'segmento', 'o-que-vende', 'regiao', 'concorrentes'].forEach(clearError);
    }

    // Rastreamento de cliques no link do WhatsApp
    document.querySelectorAll('.js-wa-link').forEach((link) => {
      link.addEventListener('click', () => {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'whatsapp_click', origem: 'visibilidade_ia' });
      });
    });

    // Rolar suavemente e focar no primeiro campo
    if (ctaScrollBtn && siteInput) {
      ctaScrollBtn.addEventListener('click', () => {
        const target = document.getElementById('form-container') || form;
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        setTimeout(() => {
          siteInput.focus();
        }, 350);
      });
    }

    // Envio do formulário
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearAllErrors();

        const siteVal = siteInput ? siteInput.value.trim() : '';
        const nomeVal = nomeInput ? nomeInput.value.trim() : '';
        const waVal = waInput ? waInput.value.trim() : '';
        const segmentoVal = segmentoInput ? segmentoInput.value : '';
        const oQueVendeVal = oQueVendeInput ? oQueVendeInput.value.trim() : '';
        const regiaoVal = regiaoInput ? regiaoInput.value.trim() : '';
        const concorrentesVal = concorrentesInput ? concorrentesInput.value.trim() : '';

        // Validações
        if (!siteVal) {
          setError('site', 'Por favor, informe o endereço do site.');
          return;
        }

        if (!isValidDomainOrUrl(siteVal)) {
          setError('site', 'Informe um endereço válido (ex.: seusite.com.br).');
          return;
        }

        if (!nomeVal || nomeVal.length < 2) {
          setError('nome', 'Por favor, informe o seu nome.');
          return;
        }

        if (!waVal) {
          setError('whatsapp', 'Por favor, informe o seu WhatsApp.');
          return;
        }

        if (!isValidPhone(waVal)) {
          setError('whatsapp', 'Informe um número válido com DDD (ex.: 11 91234-5678).');
          return;
        }

        if (!segmentoVal) {
          setError('segmento', 'Selecione o segmento da sua empresa.');
          return;
        }

        if (!oQueVendeVal || oQueVendeVal.length < 2) {
          setError('o-que-vende', 'Informe o que sua empresa vende.');
          return;
        }

        if (!regiaoVal || regiaoVal.length < 2) {
          setError('regiao', 'Informe a cidade ou região atendida.');
          return;
        }

        // Desabilita botão durante o envio
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.classList.add('is-loading');
          const span = submitBtn.querySelector('span');
          if (span) span.textContent = 'Enviando...';
        }

        const normalizedSite = normalizeUrl(siteVal);

        // Captura UTMs e gclid da URL
        const params = new URLSearchParams(window.location.search);
        const utm_source = params.get('utm_source') || '';
        const utm_medium = params.get('utm_medium') || '';
        const utm_campaign = params.get('utm_campaign') || '';
        const gclid = params.get('gclid') || '';

        const payload = {
          tipo: 'visibilidade_ia',
          site: normalizedSite,
          nome: nomeVal,
          whatsapp: waVal,
          segmento: segmentoVal,
          o_que_vende: oQueVendeVal,
          regiao: regiaoVal,
          concorrentes: concorrentesVal,
          pagina_origem: 'visibilidade-em-ia',
          utm_source: utm_source,
          utm_medium: utm_medium,
          utm_campaign: utm_campaign,
          gclid: gclid,
        };

        const waText = 'Olá! Quero o teste de visibilidade em IA. Site: ' + normalizedSite + '. Vendemos: ' + oQueVendeVal + '. Região: ' + regiaoVal + '. Concorrentes: ' + (concorrentesVal || '') + '. Meu nome é ' + nomeVal + '.';
        const waFallbackUrl = 'https://wa.me/551123912873?text=' + encodeURIComponent(waText);

        function triggerTracking() {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: 'ia_lead', segmento: segmentoVal });
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'generate_lead', { form_name: 'visibilidade_ia' });
          }
        }

        function showConfirmation() {
          triggerTracking();
          if (container) {
            container.innerHTML = `
              <div class="rx-confirmation" role="status" aria-live="polite">
                <div class="rx-confirmation__badge" aria-hidden="true">✓</div>
                <h3 class="rx-confirmation__title">Solicitação confirmada</h3>
                <p class="rx-confirmation__text">
                  Recebido! Em até 3 dias úteis você recebe no WhatsApp o resultado do teste de <strong>${escapeHtml(normalizedSite)}</strong>. Se preferir adiantar, fale com a gente: <a href="https://wa.me/551123912873" target="_blank" rel="noopener noreferrer" class="rx-confirmation__phone-link js-wa-link">(11) 2391-2873</a>.
                </p>
              </div>
            `;
            container.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        }

        function executeFallback() {
          window.open(waFallbackUrl, '_blank');
          showConfirmation();
        }

        function escapeHtml(str) {
          const div = document.createElement('div');
          div.textContent = str;
          return div.innerHTML;
        }

        if (!FORM_ENDPOINT || FORM_ENDPOINT.trim() === '') {
          // Endpoint vazio: executa fallback direto
          executeFallback();
        } else {
          // Endpoint configurado: tenta envio via POST
          try {
            const res = await fetch(FORM_ENDPOINT, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
              },
              body: JSON.stringify(payload),
            });

            if (res.ok) {
              showConfirmation();
            } else {
              executeFallback();
            }
          } catch (err) {
            executeFallback();
          }
        }
      });
    }
  });
</script>

