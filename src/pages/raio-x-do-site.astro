---
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaOrg from '../components/seo/SchemaOrg.astro';

const pageTitle = 'Raio-x gratuito do seu site | Nexus TC';
const pageDescription = 'Informe seu site e receba em até 48h os 3 pontos que mais travam seus contatos pelo Google, com um vídeo curto mostrando cada um.';
const canonicalUrl = 'https://nexustc.com.br/raio-x-do-site';

const faqs = [
  {
    question: 'É gratuito mesmo?',
    answer: 'Sim. É a forma que a Nexus usa para mostrar como trabalha.',
  },
  {
    question: 'Vou ser pressionado a contratar?',
    answer: 'Não. Você recebe os achados e decide se quer ajuda.',
  },
  {
    question: 'Vocês precisam de acesso ao meu site ou ao Google?',
    answer: 'Não. A análise é feita pelo lado de fora, como o cliente e o Google veem.',
  },
  {
    question: 'E se o meu site não tiver problema?',
    answer: 'Aí você também fica sabendo, e isso já vale.',
  },
];

const pageSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: pageTitle,
    description: pageDescription,
    url: canonicalUrl,
    inLanguage: 'pt-BR',
    isPartOf: {
      '@type': 'WebSite',
      name: 'Nexus TC',
      url: 'https://nexustc.com.br',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  hideHeader={true}
  hideFooter={true}
>
  <SchemaOrg schema={pageSchemas} />

  <!-- Header Simplificado: Logo + Botão discreto de WhatsApp -->
  <header class="rx-header">
    <div class="rx-header__inner">
      <a href="/" class="ds-logo" aria-label="Nexus TC - Página inicial">
        <span class="ds-logo__mark" aria-hidden="true"></span>
        <span>Nexus TC</span>
      </a>

      <a
        href="https://wa.me/551123912873"
        target="_blank"
        rel="noopener noreferrer"
        class="ds-btn ds-btn--secondary ds-btn--sm js-wa-link"
        aria-label="Falar no WhatsApp (abre em nova aba)"
      >
        <span>Falar no WhatsApp</span>
      </a>
    </div>
  </header>

  <!-- Seção 1: Hero com Formulário Mobile-First -->
  <section class="rx-hero" aria-labelledby="hero-title">
    <div class="rx-container">
      <div class="rx-hero__head">
        <span class="ds-chip">Diagnóstico gratuito</span>
        <h1 id="hero-title" class="rx-h1">Por que seu site recebe visitas e não recebe contatos?</h1>
        <p class="rx-lead">
          Informe seu site e, em até 48h, você recebe no WhatsApp os 3 pontos que mais travam seus contatos, com um vídeo curto mostrando onde estão e como corrigir.
        </p>
      </div>

      <!-- Formulário de Captação -->
      <div class="rx-form-box" id="form-container">
        <form id="form-raio-x" class="rx-form" novalidate>
          <div class="rx-form__grid">
            <div class="rx-form__field">
              <label for="rx-site" class="rx-label">Endereço do site *</label>
              <input
                type="url"
                id="rx-site"
                name="site"
                class="rx-input"
                placeholder="seusite.com.br"
                autocomplete="url"
                required
              />
              <span class="rx-error" id="error-site" aria-live="polite"></span>
            </div>

            <div class="rx-form__field">
              <label for="rx-nome" class="rx-label">Seu nome *</label>
              <input
                type="text"
                id="rx-nome"
                name="nome"
                class="rx-input"
                placeholder="Nome completo"
                autocomplete="name"
                required
              />
              <span class="rx-error" id="error-nome" aria-live="polite"></span>
            </div>
          </div>

          <div class="rx-form__grid">
            <div class="rx-form__field">
              <label for="rx-whatsapp" class="rx-label">WhatsApp *</label>
              <input
                type="tel"
                id="rx-whatsapp"
                name="whatsapp"
                class="rx-input"
                placeholder="(11) 91234-5678"
                autocomplete="tel"
                required
              />
              <span class="rx-error" id="error-whatsapp" aria-live="polite"></span>
            </div>

            <div class="rx-form__field">
              <label for="rx-segmento" class="rx-label">Segmento *</label>
              <select id="rx-segmento" name="segmento" class="rx-select" required>
                <option value="" disabled selected>Selecione seu segmento</option>
                <option value="Indústria">Indústria</option>
                <option value="Logística/Distribuição">Logística/Distribuição</option>
                <option value="Startup/SaaS">Startup/SaaS</option>
                <option value="Escola">Escola</option>
                <option value="Negócio nos EUA">Negócio nos EUA</option>
                <option value="Outro">Outro</option>
              </select>
              <span class="rx-error" id="error-segmento" aria-live="polite"></span>
            </div>
          </div>

          <div class="rx-form__action">
            <button type="submit" id="rx-submit-btn" class="ds-btn ds-btn--primary rx-submit-btn">
              <span>Quero meu raio-x</span>
            </button>
            <p class="rx-microtext">
              Gratuito. Sem reunião e sem proposta automática. Uma pessoa analisa o seu site.
            </p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- Seção 2: O que você recebe -->
  <section class="rx-section rx-section--alt" aria-labelledby="recebe-title">
    <div class="rx-container">
      <div class="rx-section__head">
        <span class="ds-label">Conteúdo do diagnóstico</span>
        <h2 id="recebe-title" class="ds-h2">O que você recebe</h2>
      </div>

      <div class="rx-cards-grid">
        <div class="rx-card">
          <span class="rx-card__num" aria-hidden="true">01</span>
          <p class="rx-card__text">
            3 achados concretos sobre o seu site, e não um relatório genérico de 40 páginas.
          </p>
        </div>

        <div class="rx-card">
          <span class="rx-card__num" aria-hidden="true">02</span>
          <p class="rx-card__text">
            Um vídeo de até 5 minutos mostrando cada ponto na tela.
          </p>
        </div>

        <div class="rx-card">
          <span class="rx-card__num" aria-hidden="true">03</span>
          <p class="rx-card__text">
            O que corrigir primeiro, por ordem de impacto nos contatos.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Seção 3: Como funciona -->
  <section class="rx-section" aria-labelledby="funciona-title">
    <div class="rx-container">
      <div class="rx-section__head">
        <span class="ds-label">Passo a passo</span>
        <h2 id="funciona-title" class="ds-h2">Como funciona</h2>
      </div>

      <div class="rx-steps-grid">
        <div class="rx-step">
          <div class="rx-step__badge">1</div>
          <div class="rx-step__body">
            <h3 class="rx-step__title">Você informa o site.</h3>
          </div>
        </div>

        <div class="rx-step">
          <div class="rx-step__badge">2</div>
          <div class="rx-step__body">
            <h3 class="rx-step__title">
              Analisamos como o Google enxerga a página, se o caminho até o contato funciona e o que aparece para quem busca o seu serviço.
            </h3>
          </div>
        </div>

        <div class="rx-step">
          <div class="rx-step__badge">3</div>
          <div class="rx-step__body">
            <h3 class="rx-step__title">
              Em até 48h úteis, você recebe tudo no WhatsApp. Se quiser ajuda para corrigir, a gente conversa. Se não quiser, o material é seu.
            </h3>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Seção 4: Exemplos do que costumamos encontrar -->
  <section class="rx-section rx-section--alt" aria-labelledby="exemplos-title">
    <div class="rx-container">
      <div class="rx-section__head">
        <span class="ds-label">Diagnósticos reais</span>
        <h2 id="exemplos-title" class="ds-h2">Exemplos do que costumamos encontrar</h2>
      </div>

      <div class="rx-examples-grid">
        <div class="rx-example-item">
          <span class="rx-example-item__bullet" aria-hidden="true"></span>
          <p class="rx-example-item__text">Botão de WhatsApp no site que não abre nada.</p>
        </div>

        <div class="rx-example-item">
          <span class="rx-example-item__bullet" aria-hidden="true"></span>
          <p class="rx-example-item__text">Os 9 serviços da home levando todos para a mesma página.</p>
        </div>

        <div class="rx-example-item">
          <span class="rx-example-item__bullet" aria-hidden="true"></span>
          <p class="rx-example-item__text">Dois endereços diferentes no mesmo site, confundindo o Google no mapa.</p>
        </div>

        <div class="rx-example-item">
          <span class="rx-example-item__bullet" aria-hidden="true"></span>
          <p class="rx-example-item__text">Botão de matrícula ainda com o ano anterior.</p>
        </div>
      </div>

      <div class="rx-closing-note">
        <p class="rx-closing-note__text">
          São detalhes que ninguém da empresa vê, porque ninguém testa o próprio site como cliente.
        </p>
      </div>
    </div>
  </section>

  <!-- Seção 5: Para quem é -->
  <section class="rx-section" aria-labelledby="publico-title">
    <div class="rx-container">
      <div class="rx-section__head">
        <span class="ds-label">Perfil de empresas</span>
        <h2 id="publico-title" class="ds-h2">Para quem é</h2>
      </div>

      <div class="rx-target-box">
        <p class="rx-target-box__text">
          Empresas que já têm site e algum tráfego, mas sentem que o telefone e o WhatsApp não tocam na mesma proporção. Indústria, logística, distribuição, startups, escolas e negócios brasileiros nos Estados Unidos.
        </p>
      </div>
    </div>
  </section>

  <!-- Seção 6: Perguntas frequentes -->
  <section class="rx-section rx-section--alt" aria-labelledby="faq-title">
    <div class="rx-container">
      <div class="rx-section__head">
        <span class="ds-label">Dúvidas comuns</span>
        <h2 id="faq-title" class="ds-h2">Perguntas frequentes</h2>
      </div>

      <div class="rx-faq-list">
        {faqs.map((faq) => (
          <details class="rx-faq-item">
            <summary class="rx-faq-question">
              <span class="rx-faq-q-text">{faq.question}</span>
              <span class="rx-faq-icon" aria-hidden="true">+</span>
            </summary>
            <div class="rx-faq-answer">
              <p class="rx-faq-a-text">{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Seção 7: CTA Final -->
  <section class="rx-cta-final" aria-labelledby="cta-final-title">
    <div class="rx-container">
      <div class="rx-cta-final__box ds-grain">
        <h2 id="cta-final-title" class="rx-cta-final__title">Descubra o que está travando seus contatos</h2>
        <button type="button" id="cta-scroll-btn" class="ds-btn ds-btn--secondary rx-cta-final__btn">
          <span>Quero meu raio-x</span>
        </button>
        <a href="/visibilidade-em-ia" class="rx-cross-link">
          Quer saber também se a sua empresa aparece no ChatGPT? Faça o teste gratuito
        </a>
      </div>
    </div>
  </section>

  <!-- Rodapé Simplificado -->
  <footer class="rx-footer">
    <div class="rx-container">
      <p class="rx-footer__text">
        Nexus TC | Tráfego e conversão | SEO, Google Ads, CRO e sites.
      </p>
    </div>
  </footer>
</BaseLayout>

<script is:inline>
  // Constante de endpoint solicitada
  const FORM_ENDPOINT = 'https://api.web3forms.com/submit';

  // Utilitários de normalização e validação
  function normalizeUrl(value) {
    if (!value) return '';
    let val = value.trim();
    if (!/^https?:\/\//i.test(val)) {
      val = 'https://' + val;
    }
    return val;
  }

  function isValidDomainOrUrl(value) {
    if (!value) return false;
    const normalized = normalizeUrl(value);
    try {
      const parsed = new URL(normalized);
      return parsed.hostname.includes('.') && parsed.hostname.length >= 4;
    } catch {
      return false;
    }
  }

  function formatPhoneInput(val) {
    if (!val) return '';
    const trimmed = val.trim();
    const isUS = trimmed.startsWith('+');

    if (isUS) {
      const digits = trimmed.slice(1).replace(/\D/g, '');
      if (digits.startsWith('1')) {
        const sub = digits.slice(1, 11);
        if (sub.length === 0) return '+1 ';
        if (sub.length <= 3) return '+1 (' + sub;
        if (sub.length <= 6) return '+1 (' + sub.slice(0, 3) + ') ' + sub.slice(3);
        return '+1 (' + sub.slice(0, 3) + ') ' + sub.slice(3, 6) + '-' + sub.slice(6);
      }
      return '+' + digits.slice(0, 15);
    }

    const digits = val.replace(/\D/g, '').slice(0, 11);
    if (digits.length === 0) return '';
    if (digits.length <= 2) return '(' + digits;
    if (digits.length <= 6) return '(' + digits.slice(0, 2) + ') ' + digits.slice(2);
    if (digits.length <= 10) return '(' + digits.slice(0, 2) + ') ' + digits.slice(2, 6) + '-' + digits.slice(6);
    return '(' + digits.slice(0, 2) + ') ' + digits.slice(2, 7) + '-' + digits.slice(7);
  }

  function isValidPhone(val) {
    if (!val) return false;
    const trimmed = val.trim();
    if (trimmed.startsWith('+1')) {
      const digits = trimmed.replace(/\D/g, '');
      return digits.length === 11; // 1 + 10 digits
    }
    if (trimmed.startsWith('+')) {
      const digits = trimmed.replace(/\D/g, '');
      return digits.length >= 8 && digits.length <= 15;
    }
    const digits = val.replace(/\D/g, '');
    return digits.length === 10 || digits.length === 11;
  }

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('form-raio-x');
    const container = document.getElementById('form-container');
    const siteInput = document.getElementById('rx-site');
    const nomeInput = document.getElementById('rx-nome');
    const waInput = document.getElementById('rx-whatsapp');
    const segmentoInput = document.getElementById('rx-segmento');
    const submitBtn = document.getElementById('rx-submit-btn');
    const ctaScrollBtn = document.getElementById('cta-scroll-btn');

    // Máscara de telefone
    if (waInput) {
      waInput.addEventListener('input', (e) => {
        const start = waInput.selectionStart;
        const oldVal = waInput.value;
        const formatted = formatPhoneInput(oldVal);
        waInput.value = formatted;
        clearError('whatsapp');
      });
    }

    // Normalização do site no blur
    if (siteInput) {
      siteInput.addEventListener('blur', () => {
        if (siteInput.value.trim()) {
          siteInput.value = normalizeUrl(siteInput.value);
        }
      });
      siteInput.addEventListener('input', () => clearError('site'));
    }

    if (nomeInput) {
      nomeInput.addEventListener('input', () => clearError('nome'));
    }

    if (segmentoInput) {
      segmentoInput.addEventListener('change', () => clearError('segmento'));
    }

    function setError(fieldName, message) {
      const errEl = document.getElementById('error-' + fieldName);
      const inputEl = document.getElementById('rx-' + fieldName);
      if (errEl) errEl.textContent = message;
      if (inputEl) inputEl.setAttribute('aria-invalid', 'true');
    }

    function clearError(fieldName) {
      const errEl = document.getElementById('error-' + fieldName);
      const inputEl = document.getElementById('rx-' + fieldName);
      if (errEl) errEl.textContent = '';
      if (inputEl) inputEl.removeAttribute('aria-invalid');
    }

    function clearAllErrors() {
      ['site', 'nome', 'whatsapp', 'segmento'].forEach(clearError);
    }

    // Rastreamento global de cliques em links de WhatsApp
    document.addEventListener('click', (e) => {
      const waLink = e.target.closest('a[href*="wa.me"]');
      if (waLink) {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'whatsapp_click', origem: 'raio_x' });
      }
    });

    // Botão da seção 7 (scroll suave + focar primeiro campo)
    if (ctaScrollBtn) {
      ctaScrollBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const targetForm = document.getElementById('form-raio-x');
        if (targetForm) {
          targetForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
          if (siteInput) {
            setTimeout(() => siteInput.focus(), 400);
          }
        }
      });
    }

    // Submissão do formulário
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearAllErrors();

        let hasError = false;
        let firstInvalidField = null;

        const siteVal = siteInput ? siteInput.value.trim() : '';
        const nomeVal = nomeInput ? nomeInput.value.trim() : '';
        const waVal = waInput ? waInput.value.trim() : '';
        const segmentoVal = segmentoInput ? segmentoInput.value : '';

        // Validação do site
        if (!siteVal) {
          setError('site', 'Informe o endereço do seu site.');
          hasError = true;
          firstInvalidField = firstInvalidField || siteInput;
        } else if (!isValidDomainOrUrl(siteVal)) {
          setError('site', 'Informe um endereço de site válido.');
          hasError = true;
          firstInvalidField = firstInvalidField || siteInput;
        }

        // Validação do nome
        if (!nomeVal || nomeVal.length < 2) {
          setError('nome', 'Informe seu nome.');
          hasError = true;
          firstInvalidField = firstInvalidField || nomeInput;
        }

        // Validação do WhatsApp
        if (!waVal) {
          setError('whatsapp', 'Informe seu número de WhatsApp.');
          hasError = true;
          firstInvalidField = firstInvalidField || waInput;
        } else if (!isValidPhone(waVal)) {
          setError('whatsapp', 'Informe um WhatsApp válido com DDD ou código internacional.');
          hasError = true;
          firstInvalidField = firstInvalidField || waInput;
        }

        // Validação do segmento
        if (!segmentoVal) {
          setError('segmento', 'Selecione o segmento da sua empresa.');
          hasError = true;
          firstInvalidField = firstInvalidField || segmentoInput;
        }

        if (hasError) {
          if (firstInvalidField) firstInvalidField.focus();
          return;
        }

        // Desabilita botão durante envio
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.classList.add('is-loading');
          submitBtn.innerHTML = '<span>Enviando...</span>';
        }

        const normalizedSite = normalizeUrl(siteVal);

        // Captura UTMs e gclid da URL
        const params = new URLSearchParams(window.location.search);
        const utm_source = params.get('utm_source') || '';
        const utm_medium = params.get('utm_medium') || '';
        const utm_campaign = params.get('utm_campaign') || '';
        const gclid = params.get('gclid') || '';

        const payload = {
          access_key: '0b185e08-f35e-4860-8670-2ccd5bf8aae5',
          from_name: 'Site Nexus TC',
          subject: 'Novo raio-x solicitado - Nexus TC',
          site: normalizedSite,
          nome: nomeVal,
          whatsapp: waVal,
          segmento: segmentoVal,
          pagina_origem: 'raio-x-do-site',
          utm_source: utm_source,
          utm_medium: utm_medium,
          utm_campaign: utm_campaign,
          gclid: gclid,
        };

        const waText = 'Olá! Quero o raio-x do site ' + normalizedSite + '. Meu nome é ' + nomeVal + ', segmento ' + segmentoVal + '.';
        const waFallbackUrl = 'https://wa.me/551123912873?text=' + encodeURIComponent(waText);

        function triggerTracking() {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: 'raio_x_lead', segmento: segmentoVal });
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'gerar_lead', { form_name: 'raio_x' });
          }
        }

        function showConfirmation() {
          if (container) {
            container.innerHTML = `
              <div class="rx-confirmation" role="status" aria-live="polite">
                <div class="rx-confirmation__badge" aria-hidden="true">✓</div>
                <h3 class="rx-confirmation__title">Solicitação confirmada</h3>
                <p class="rx-confirmation__text">
                  Recebido! Em até 48h úteis você recebe o raio-x de <strong>${escapeHtml(normalizedSite)}</strong> no WhatsApp. Se preferir adiantar, fale com a gente: <a href="https://wa.me/551123912873" target="_blank" rel="noopener noreferrer" class="rx-confirmation__phone-link js-wa-link">(11) 2391-2873</a>.
                </p>
              </div>
            `;
            container.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        }

        function executeFallback() {
          if (container) {
            container.innerHTML = `
              <div class="rx-confirmation" role="alert" aria-live="polite">
                <h3 class="rx-confirmation__title">Não conseguimos enviar</h3>
                <p class="rx-confirmation__text">
                  Houve um erro no envio. Fale com a gente direto no WhatsApp: <a href="${waFallbackUrl}" target="_blank" rel="noopener noreferrer" class="rx-confirmation__phone-link js-wa-link">(11) 2391-2873</a>
                </p>
              </div>
            `;
            container.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        }

        function escapeHtml(str) {
          const div = document.createElement('div');
          div.textContent = str;
          return div.innerHTML;
        }

        if (!FORM_ENDPOINT || FORM_ENDPOINT.trim() === '') {
          // Endpoint vazio: executa fallback direto
          executeFallback();
        } else {
          // Endpoint configurado: tenta envio via POST
          try {
            const res = await fetch(FORM_ENDPOINT, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
              },
              body: JSON.stringify(payload),
            });

            if (res.ok) {
              triggerTracking();
              showConfirmation();
            } else {
              executeFallback();
            }
          } catch (err) {
            executeFallback();
          }
        }
      });
    }
  });
</script>

<style>
  /* Header Simplificado */
  .rx-header {
    height: 56px;
    background: var(--surface-raised);
    border-bottom: 1px solid var(--line);
    display: flex;
    align-items: center;
  }

  .rx-header__inner {
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Layout Base & Container */
  .rx-container {
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  /* Seção 1: Hero */
  .rx-hero {
    padding: var(--space-6) 0 var(--space-12);
    border-bottom: 1px solid var(--line);
    background: var(--surface-page);
  }

  .rx-hero__head {
    margin-bottom: var(--space-6);
  }

  .rx-h1 {
    font-size: clamp(28px, 5vw, 44px);
    line-height: 1.1;
    font-weight: 500;
