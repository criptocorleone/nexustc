---
const currentYear = new Date().getFullYear();
---

<footer class="ds-footer">
  <div class="ds-footer__inner">
    <div class="ds-footer__brand">
      <a href="/" class="ds-logo" aria-label="Nexus TC - Página inicial">
        <span>Nexus TC</span>
      </a>
      <p class="ds-footer__desc">
        SEO, mídia paga e CRO para a sua empresa aparecer na hora em que o comprador procura o que você vende.
      </p>
      <p class="ds-footer__reach">
        Atendemos empresas no Brasil e nos Estados Unidos.
      </p>
      <a
        href="https://wa.me/551123912873?text=Nexus"
        target="_blank"
        rel="noopener noreferrer"
        class="ds-footer__wa"
        data-wa-btn
        data-page-origin="rodape"
        aria-label="Conversar no WhatsApp (abre em nova aba)"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="16"
          height="16"
          aria-hidden="true"
          class="ds-wa-svg"
        >
          <path
            fill="#ffffff"
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 00-3.48-8.413z"
          />
        </svg>
        <span>Conversar no WhatsApp</span>
      </a>
    </div>

    <div class="ds-footer__cols">
      <div class="ds-footer__col">
        <span class="ds-label">Serviços</span>
        <ul class="ds-footer__list">
          <li><a href="/solucoes/consultoria-seo">Consultoria de SEO</a></li>
          <li><a href="/solucoes/gestao-de-google-ads">Gestão de Mídia Paga</a></li>
          <li><a href="/solucoes/otimizacao-de-conversao">Otimização de Conversão (CRO)</a></li>
        </ul>
      </div>

      <div class="ds-footer__col">
        <span class="ds-label">Segmentos</span>
        <ul class="ds-footer__list">
          <li><a href="/segmentos/web3">Empresas Web3</a></li>
          <li><a href="/segmentos/startups-e-saas">Startups e SaaS B2B</a></li>
          <li><a href="/segmentos/industria">Indústria e Manufatura</a></li>
          <li><a href="/segmentos/logistica">Logística e Infraestrutura</a></li>
          <li><a href="/segmentos/distribuidores">Distribuidores</a></li>
          <li><a href="/segmentos/escolas">Escolas e Educação</a></li>
        </ul>
      </div>

      <div class="ds-footer__col">
        <span class="ds-label">Institucional</span>
        <ul class="ds-footer__list">
          <li><a href="/sobre">Sobre a Nexus TC</a></li>
          <li><a href="/insights">Blog e Artigos</a></li>
          <li><a href="/contato">Contato</a></li>
          <li><a href="/politica-de-privacidade">Política de Privacidade</a></li>
          <li><a href="/termos-de-uso">Termos de Uso</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="ds-footer__bottom">
    <p>© {currentYear} Nexus TC. Todos os direitos reservados.</p>
  </div>
</footer>

<style>
  .ds-footer {
    background: var(--surface-raised);
    border-top: 1px solid var(--line);
    padding: var(--space-16) var(--space-12) var(--space-8);
  }

  .ds-footer__inner {
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: var(--space-12);
    margin-bottom: var(--space-12);
  }

  .ds-footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .ds-footer__desc {
    font-size: var(--text-md, 16px);
    line-height: 1.6;
    color: var(--ink-muted);
    margin: 0;
    max-width: 32ch;
  }

  .ds-footer__reach {
    font-family: var(--font-mono);
    font-size: var(--text-xs, 13px);
    line-height: 1.5;
    color: var(--ink-subtle);
    margin: 0;
  }

  .ds-footer__wa {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-sm, 14px);
    font-weight: 500;
    color: #ffffff;
    text-decoration: none;
    width: fit-content;
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid #11803C;
    background: #11803C;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .ds-footer__wa:hover {
    background-color: #0d6b32;
    border-color: #0d6b32;
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(17, 128, 60, 0.25);
  }

  .ds-footer__cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .ds-footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .ds-footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .ds-footer__list a {
    font-size: var(--text-base, 15px);
    line-height: 1.5;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .ds-footer__list a:hover {
    color: var(--brand);
  }

  .ds-footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--line);
    padding-top: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-2xs, 12px);
    color: var(--ink-subtle);
  }

  .ds-footer__bottom p {
    margin: 0;
  }

  @media (max-width: 900px) {
    .ds-footer {
      padding: var(--space-12) var(--space-6) var(--space-6);
    }

    .ds-footer__inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .ds-footer__cols {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .ds-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>
